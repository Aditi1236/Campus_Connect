# ---- Server ----
PORT=5000
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/findit

# Long random string used to sign JWT tokens. NEVER share or commit it.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend URL(s) allowed by CORS (comma separated)
CLIENT_URL=http://localhost:5173

# Image storage:
#   local    -> files saved in server/uploads (good for local development)
#   database -> images saved inside MongoDB (persistent on Render/Heroku-like hosts)
STORAGE_MODE=local

# Optional: only allow emails from this domain to register (e.g. college.edu). Leave empty to allow all.
ALLOWED_EMAIL_DOMAIN=

# Admin account created by `npm run seed`
ADMIN_NAME=Campus Admin
ADMIN_EMAIL=admin@findit.com
ADMIN_STUDENT_ID=ADMIN001
ADMIN_PASSWORD=
